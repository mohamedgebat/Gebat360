# GEBAT 360° ERP — Configuration Exemple (Template)
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000/api/v1

# Base de Données MySQL
DATABASE_URL=mysql://root:password@localhost:3306/gebat_360_db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=gebat_360_db

# Clés Secrètes JWT & Auth
JWT_SECRET=remplacer_par_cle_secrete_jwt_securisee
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=remplacer_par_cle_refresh_securisee
