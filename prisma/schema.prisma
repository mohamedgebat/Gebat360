// GEBAT 360° ERP — Prisma Database Schema (Modèle Relational ERP Complet)

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DIRECTION
  DIRECTEUR_PROJET
  CONDUCTEUR_TRAVAUX
  COST_CONTROLLER
  ACHETEUR
  MAGASINIER
  COMPTABLE
  CONSULTATION
  DIRECTION_GENERALE
  DAF
  DIRECTEUR_TECHNIQUE
  CHEF_CHANTIER
  ACHATS
}

enum UserStatus {
  ACTIF
  INACTIF
}

enum ProjectStatus {
  EN_ETUDE
  EN_COURS
  EN_PAUSE
  LIVRE
  CLOTURE
}

enum RiskLevel {
  FAIBLE
  MODERE
  ELEVE
  CRITIQUE
}

enum WbsLevel {
  PROJET
  LOT
  SOUS_LOT
  ACTIVITE
}

enum ProcurementWorkflowStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CLOSED
}

enum DaStatus {
  BROUILLON
  SOUMISE
  EN_VALIDATION
  RETOUR_CORRECTION
  VALIDEE
  REFUSEE
  ANNULEE
  TRANSFORMEE_EN_BC
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  INVOICED
  CLOSED
}

model Company {
  id        String    @id @default(uuid())
  code      String    @unique
  name      String
  country   String    @default("Côte d'Ivoire")
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]

  @@map("companies")
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  role               Role       @default(SUPER_ADMIN)
  avatar             String     @default("US")
  photoUrl           String?
  phone              String?
  employeeCode       String?
  company            String     @default("GEBAT SA")
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  status             UserStatus @default(ACTIF)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  notifications Notification[]

  @@map("users")
}

model Project {
  id             String        @id @default(uuid())
  code           String        @unique
  domainCode     String?
  name           String
  companyId      String?
  companyRef     Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  company        String
  client         String
  country        String
  location       String
  activity       String
  manager        String
  contractRef    String
  contractAmount Decimal       @db.Decimal(18, 2)
  currency       String        @default("XOF")
  signatureDate  DateTime
  startDate      DateTime
  durationMonths Int
  endDate        DateTime
  initialBudget  Decimal       @db.Decimal(18, 2)
  revisedBudget  Decimal       @db.Decimal(18, 2)
  progress       Decimal       @default(0.0) @db.Decimal(5, 2)
  status         ProjectStatus @default(EN_COURS)
  risk           RiskLevel     @default(FAIBLE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  wbsNodes         WbsNode[]
  purchaseRequests PurchaseRequest[]
  planningTasks    PlanningTask[]
  productionReports ProductionReport[]

  @@map("projects")
}

model WbsNode {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code               String
  name               String
  description        String?
  unit               String?  @default("m3")
  plannedQty         Decimal  @default(0.0) @db.Decimal(15, 2)
  unitCost           Decimal  @default(0.0) @db.Decimal(18, 2)
  contractUnitPrice  Decimal  @default(0.0) @db.Decimal(18, 2)
  contractAmount     Decimal  @default(0.0) @db.Decimal(18, 2)
  initialBudget      Decimal  @default(0.0) @db.Decimal(18, 2)
  revisedBudget      Decimal  @default(0.0) @db.Decimal(18, 2)
  reserved           Decimal  @default(0.0) @db.Decimal(18, 2)
  committed          Decimal  @default(0.0) @db.Decimal(18, 2)
  received           Decimal  @default(0.0) @db.Decimal(18, 2)
  invoiced           Decimal  @default(0.0) @db.Decimal(18, 2)
  actualCost         Decimal  @default(0.0) @db.Decimal(18, 2)
  remainingToCommit  Decimal  @default(0.0) @db.Decimal(18, 2)
  remainingToProduce Decimal  @default(0.0) @db.Decimal(15, 2)
  forecast           Decimal  @default(0.0) @db.Decimal(18, 2)
  eac                Decimal  @default(0.0) @db.Decimal(18, 2)
  progress           Decimal  @default(0.0) @db.Decimal(5, 2)
  nature             String   @default("MAT")
  manager            String   @default("Chef de Chantier")
  parentId           String?
  level              WbsLevel @default(ACTIVITE)
  type               WbsLevel @default(ACTIVITE)
  status             String   @default("EN_COURS")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  purchaseRequests PurchaseRequest[]
  costTransactions CostTransaction[]
  eacSnapshots     EACSnapshot[]

  @@map("wbs_nodes")
}

model CostNature {
  id          String   @id @default(uuid())
  code        String   @unique
  label       String
  status      String   @default("Actif")
  description String?
  createdAt   DateTime @default(now())

  @@map("cost_natures")
}

model Supplier {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  category       String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  taxNumber      String?
  status         String          @default("Actif")
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseRequest {
  id                 String          @id @default(uuid())
  code               String          @unique
  projectId          String
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName        String
  wbsId              String
  wbs                WbsNode         @relation(fields: [wbsId], references: [id], onDelete: Cascade)
  wbsCode            String
  wbsName            String
  nature             String
  itemDescription    String
  quantity           Decimal         @db.Decimal(15, 2)
  unit               String
  estimatedUnitPrice Decimal         @db.Decimal(18, 2)
  estimatedTotal     Decimal         @db.Decimal(18, 2)
  desiredDate        DateTime
  urgency            String          @default("Normale")
  justification      String?
  createdBy          String
  status             DaStatus        @default(EN_VALIDATION)
  isOverBudget       Boolean         @default(false)
  overBudgetAmount   Decimal         @default(0.0) @db.Decimal(18, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  purchaseOrders     PurchaseOrder[]

  @@map("purchase_requests")
}

model PurchaseOrder {
  id          String          @id @default(uuid())
  code        String          @unique
  daId        String
  da          PurchaseRequest @relation(fields: [daId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  totalAmount Decimal         @db.Decimal(18, 2)
  issueDate   DateTime        @default(now())
  status      String          @default("Émis")
  createdAt   DateTime        @default(now())

  goodsReceipts GoodsReceipt[]

  @@map("purchase_orders")
}

model GoodsReceipt {
  id          String        @id @default(uuid())
  code        String        @unique
  poId        String
  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  poCode      String
  projectId   String
  wbsId       String
  supplier    String
  receiptDate DateTime      @default(now())
  receivedBy  String
  status      String        @default("Validé")
  createdAt   DateTime      @default(now())

  supplierInvoices SupplierInvoice[]

  @@map("goods_receipts")
}

model SupplierInvoice {
  id             String       @id @default(uuid())
  code           String       @unique
  receiptId      String
  goodsReceipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  invoiceNumber  String
  supplier       String
  invoiceAmount  Decimal      @db.Decimal(18, 2)
  invoiceDate    DateTime     @default(now())
  dueDate        DateTime
  status         String       @default("INVOICED")
  createdAt      DateTime     @default(now())

  @@map("supplier_invoices")
}

model Warehouse {
  id        String      @id @default(uuid())
  code      String      @unique
  name      String
  location  String
  manager   String
  createdAt DateTime    @default(now())
  items     StockItem[]

  @@map("warehouses")
}

model StockItem {
  id               String     @id @default(uuid())
  code             String     @unique
  name             String
  category         String
  unit             String
  warehouseId      String?
  warehouseRef     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  warehouse        String
  minThreshold     Decimal    @default(0.0) @db.Decimal(12, 2)
  currentStock     Decimal    @default(0.0) @db.Decimal(12, 2)
  averageUnitPrice Decimal    @default(0.0) @db.Decimal(18, 2)
  totalValue       Decimal    @default(0.0) @db.Decimal(18, 2)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("stock_items")
}

enum MovementType {
  IN
  OUT
  TRANSFER
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id           String       @id @default(uuid())
  code         String       @unique
  movementType MovementType @default(IN)
  type         String       @default("ENTREE")
  itemId       String
  itemName     String
  warehouseId  String?
  warehouse    String
  quantity     Decimal      @db.Decimal(12, 2)
  unit         String
  unitCost     Decimal      @db.Decimal(18, 2)
  totalCost    Decimal      @db.Decimal(18, 2)
  projectId    String?
  wbsId        String?
  wbsCode      String?
  wbsName      String?
  reference    String       @default("BL-001")
  sourceDoc    String       @default("BL-001")
  createdBy    String       @default("Magasinier")
  user         String       @default("Magasinier")
  date         DateTime     @default(now())
  createdAt    DateTime     @default(now())

  @@map("stock_movements")
}

model ProductionReport {
  id            String   @id @default(uuid())
  code          String   @unique
  date          DateTime
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName   String
  wbsId         String
  wbsCode       String
  activityName  String
  weather       String   @default("Ensoleillé")
  plannedQty    Decimal  @db.Decimal(15, 2)
  realizedQty   Decimal  @db.Decimal(15, 2)
  unit          String
  workersCount  Int      @default(0)
  hoursWorked   Int      @default(0)
  notes         String?  @db.Text
  status        String   @default("Validé")
  createdBy     String
  productivity  Decimal  @default(0.0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())

  @@map("production_reports")
}

model PlanningTask {
  id           String   @id @default(uuid())
  code         String   @unique
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsCode      String
  name         String
  startDate    DateTime
  endDate      DateTime
  durationDays Int
  progress     Decimal  @default(0.0) @db.Decimal(5, 2)
  status       String   @default("En cours")
  createdAt    DateTime @default(now())

  @@map("planning_tasks")
}

model CostTransaction {
  id          String   @id @default(uuid())
  code        String   @unique
  wbsId       String
  wbs         WbsNode  @relation(fields: [wbsId], references: [id], onDelete: Cascade)
  nature      String
  description String
  amount      Decimal  @db.Decimal(18, 2)
  date        DateTime @default(now())
  source      String
  createdAt   DateTime @default(now())

  @@map("cost_transactions")
}

model EACSnapshot {
  id            String   @id @default(uuid())
  wbsId         String
  wbs           WbsNode  @relation(fields: [wbsId], references: [id], onDelete: Cascade)
  budgetDs      Decimal  @db.Decimal(18, 2)
  actualCost    Decimal  @db.Decimal(18, 2)
  forecast      Decimal  @db.Decimal(18, 2)
  eac           Decimal  @db.Decimal(18, 2)
  eacMargin     Decimal  @db.Decimal(18, 2)
  justification String?  @db.Text
  createdAt     DateTime @default(now())

  @@map("eac_snapshots")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?  @default("usr-admin-01")
  user          String   @default("Yacouba Mohamed")
  role          String   @default("Super Admin")
  action        String   // BUDGET_CREATED, BUDGET_UPDATED, FORECAST_UPDATED, PURCHASE_APPROVED, PURCHASE_REJECTED, INVOICE_POSTED, STOCK_ADJUSTED, WBS_UPDATED
  entityType    String   @default("WBSNode")
  entityId      String?
  module        String   @default("WBS")
  objectRef     String   @default("CVI-2026-HYD-001/03/02/004")
  oldValue      String?  @db.Text
  newValue      String?  @db.Text
  reason        String?  @db.Text
  justification String?  @db.Text
  timestamp     DateTime @default(now())

  @@map("audit_logs")
}
